# ==========================================
# EduSphere Production Environment Variables
# Copy this file to '.env' on your VPS and configure secrets
# ==========================================

# 1. MongoDB root credentials (change these to secure secrets!)
MONGO_DB_USER=admin
MONGO_DB_PASSWORD=SecurePassword123!

# 2. JWT Cryptographic Secrets (configure long, random hash strings!)
JWT_ACCESS_SECRET=your_super_secret_access_key_string_xyz789
JWT_REFRESH_SECRET=your_super_secret_refresh_key_string_abc456
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 3. Production Frontend URL configuration
# Set this to your live domain (e.g. http://my-lms-domain.com or VPS IP http://123.45.67.89)
# Note: Keep the port blank if running on port 80
VITE_API_BASE_URL=http://your-vps-ip-or-domain:5000

# 4. Global Super Admin Account (Seeded on first startup)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@edusphere.com
SUPERADMIN_PASSWORD=SuperAdmin123!
